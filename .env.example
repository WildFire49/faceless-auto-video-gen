# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- YouTube (M9) ---------------------------------------------------------
# From Google Cloud Console: enable the YouTube Data API v3 and the YouTube
# Analytics API, then create an OAuth client of type "Desktop app".
YT_CLIENT_SECRET_PATH=./client_secret.json
# Written by the OAuth flow on first run; also gitignored.
YT_TOKEN_PATH=./token.json
# An API key is only needed for the trending-video trend source (M3).
YT_API_KEY=

# --- Overrides ------------------------------------------------------------
# Everything else lives in config/*.yaml. These exist so you can point a
# single run somewhere else without editing committed config.
# REWIND_API_ADDR=127.0.0.1:8080
# REWIND_AI_ADDR=127.0.0.1:50051
