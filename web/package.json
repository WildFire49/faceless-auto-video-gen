    "@mui/material": "^7.0.0",
    "@mui/material-nextjs": "^7.0.0",
    "@mui/x-data-grid": "^9.14.0",
    "@tanstack/react-query": "^5.59.0",
    "motion": "^12.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.2.0",
